<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane fx:id="addWordsPane"
           dividerPositions="0.12"
           maxHeight="-Infinity"
           maxWidth="-Infinity"
           minHeight="-Infinity"
           minWidth="-Infinity"
           prefHeight="700.0"
           prefWidth="1010.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="dev.cyberjar.springfx.controller.AddWordsController">

    <items>
        <fx:include source="toolbar.fxml" />

        <AnchorPane minHeight="0.0"
                    minWidth="0.0"
                    style="-fx-background-color: #FFFFFF;">

            <children>
                <Label fx:id="titleLabel"
                       text="Add words"
                       AnchorPane.leftAnchor="20.0"
                       AnchorPane.rightAnchor="20.0"
                       AnchorPane.topAnchor="15.0">
                    <font>
                        <Font size="26.0" />
                    </font>
                </Label>

                <VBox spacing="16.0"
                      AnchorPane.leftAnchor="20.0"
                      AnchorPane.rightAnchor="20.0"
                      AnchorPane.topAnchor="70.0"
                      AnchorPane.bottomAnchor="20.0">

                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                    </padding>

                    <GridPane hgap="12.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150.0" prefWidth="150.0" />
                            <ColumnConstraints minWidth="350.0" prefWidth="500.0" />
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>

                        <children>
                            <Label text="Word / Character:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0" />

                            <TextField fx:id="termField"
                                       promptText="你好"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1" />

                            <Label text="Reading / Pinyin:"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0" />

                            <TextField fx:id="readingField"
                                       promptText="nǐ hǎo"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="1" />

                            <Label text="Translation:"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0" />

                            <TextField fx:id="translationField"
                                       promptText="hello"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="1" />

                            <Button text="Add word"
                                    onAction="#addWord"
                                    GridPane.rowIndex="3"
                                    GridPane.columnIndex="1" />
                        </children>
                    </GridPane>

                    <Label fx:id="addWordErrorLabel"
                           minHeight="24.0" />

                    <TableView fx:id="wordsTable"
                               prefWidth="502.0"
                               maxWidth="502.0"
                               prefHeight="320.0">
                        <columns>
                            <TableColumn fx:id="termColumn"
                                         text="Word"
                                         prefWidth="150.0" />

                            <TableColumn fx:id="readingColumn"
                                         text="Reading"
                                         prefWidth="150.0" />

                            <TableColumn fx:id="translationColumn"
                                         text="Translation"
                                         prefWidth="200.0" />
                        </columns>
                    </TableView>
                </VBox>

                <ImageView fx:id="bulldog"
                           fitHeight="250.0"
                           fitWidth="350.0"
                           pickOnBounds="true"
                           preserveRatio="true"
                           AnchorPane.bottomAnchor="0.0"
                           AnchorPane.rightAnchor="0.0" />
            </children>
        </AnchorPane>
    </items>
</SplitPane>
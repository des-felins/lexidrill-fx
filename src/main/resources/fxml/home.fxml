<?import javafx.scene.text.Font?>

<SplitPane fx:id="homePane" dividerPositions="0.5" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.cyberjar.springfx.controller.HomeController">
  <items>
      <fx:include source="toolbar.fxml" />
    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="398.0" prefWidth="50.0" style="-fx-background-color: #FFFFFF;">
         <children>
            <Label fx:id="helloLabel" layoutX="8.0" layoutY="14.0" prefHeight="34.0" prefWidth="531.0" text="Label" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="5.0">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
            <Label layoutX="38.0" layoutY="54.0" text="What would you like to do today?" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="0.0">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
             <GridPane layoutX="10.0"
                       layoutY="110.0"
                       hgap="10.0"
                       AnchorPane.leftAnchor="10.0"
                       AnchorPane.topAnchor="110.0">

                 <columnConstraints>
                     <ColumnConstraints minWidth="180.0" prefWidth="180.0" maxWidth="180.0" />
                     <ColumnConstraints minWidth="180.0" prefWidth="180.0" maxWidth="180.0" />
                 </columnConstraints>

                 <rowConstraints>
                     <RowConstraints minHeight="120.0" prefHeight="120.0" maxHeight="120.0" />

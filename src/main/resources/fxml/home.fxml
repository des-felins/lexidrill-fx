                     </Button>

                     <Button fx:id="practiceButton"
                             minWidth="180.0"
                             prefWidth="180.0"
                             maxWidth="180.0"
                             minHeight="120.0"
                             prefHeight="120.0"
                             maxHeight="120.0"
                             mnemonicParsing="false"
                             onAction="#practiceWords"
                             text="PRACTICE WORDS"
                             wrapText="true"
